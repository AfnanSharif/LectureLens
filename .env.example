FLASK_SECRET_KEY=replace-with-a-long-random-value
FEEDBACK_DB=instance/feedback.db
MAX_UPLOAD_MB=200
PORT=5000
SUMMARY_PROVIDER=local

# Optional local Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional OpenAI-compatible Mixtral endpoint
# MIXTRAL_BASE_URL=https://your-endpoint/v1
# MIXTRAL_API_KEY=
MIXTRAL_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
